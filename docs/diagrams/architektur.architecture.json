  "cards": [
    {
      "dot": "cyan",
      "title": "Lokal",
      "items": ["Lokal heißt: Steuerung und Laufzeitdaten – eine SQLite-Datei und eine API, die nur auf 127.0.0.1 lauscht", "Die Agent-CLIs sprechen weiterhin mit ihren Anbietern; ein Offline-Betrieb ist damit nicht gemeint"]
    },
    {
      "dot": "emerald",
      "title": "Beweis",
      "items": ["Die Board-Spalte ist eine Anzeige; ob gemergt werden darf, entscheidet die Prüfung mit Belegen und Freigabe für genau diesen Code-Stand", "Der Not-Aus meldet „gestoppt“ nur nach beobachtetem Sitzungsende; die Sperre in SQLite bleibt nach einem Neustart", "Updates werden vor der Installation per Minisign geprüft"]
    },
    {
      "dot": "amber",
      "title": "Grenzen",
      "items": ["Gemeinsame Laufzeit, keine Sicherheits-Sandbox: Agenten laufen unter demselben Betriebssystem-Nutzer, Worktrees trennen nur Arbeitsstände", "Dieselbe Fachfunktion heißt nicht dieselbe Berechtigung: die API verlangt ein Token, Freigaben zusätzlich das Verdict-Token"]
    }
  ]
